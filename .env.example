# CampusConnect AWS Environment Configuration (Template)
# Note: For AWS Amplify Gen 2, resources are managed via 'npx ampx sandbox'
# which automatically generates amplify_outputs.json in the project root.

NEXT_PUBLIC_APP_NAME="CampusConnect"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Region override (defaults to AWS config or ap-south-1)
NEXT_PUBLIC_AWS_REGION="ap-south-1"

# Deployment mode: 'cloud' (connects to AWS AppSync/DynamoDB/Cognito/S3) or 'local' (offline demo fallback)
NEXT_PUBLIC_DATA_MODE="auto"
